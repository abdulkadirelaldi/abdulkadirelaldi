# =============================================================================
# .env.example — PROGRAM.md §12 Ortam Değişkenleri
#
# §8.17: Bu dosya TÜM anahtarları DEĞERSİZ listeler. Gerçek `.env` dosyası
#        .gitignore ile dışlanmıştır ve repoya ASLA girmez.
# §8.18: NEXT_PUBLIC_ önekli hiçbir değişkende sır bulunmaz — bu dosyadaki
#        NEXT_PUBLIC_* anahtarları tarayıcıya gömülür, gizli değerdir sanılmasın.
#
# Kurulum: `cp .env.example .env` → değerleri doldur.
# =============================================================================

# --- Uygulama ---------------------------------------------------------------
# örn. https://abdulkadirelaldi.com
NEXT_PUBLIC_SITE_URL=
# örn. https://kiyimedya.com
NEXT_PUBLIC_KIYI_MEDYA_URL=
# örn. development | production   (next dev/build genelde kendisi ayarlar)
NODE_ENV=

# --- Veritabanı -------------------------------------------------------------
# Yerel geliştirme (docker-compose.dev.yml ile birebir uyumlu):
#   postgresql://aelaldi:aelaldi_dev_only@127.0.0.1:5433/aelaldi?schema=public
#
# Host portu neden 5433, 5432 değil: birçok geliştirme makinesinde sistem geneli
# kurulu bir PostgreSQL (Homebrew, Postgres.app, apt) 5432'yi zaten tutar.
# Çakışma SESSİZDİR — container "healthy" görünür ama bağlantılar host'taki diğer
# sunucuya gider ve `role "aelaldi" does not exist` gibi tamamen yanıltıcı bir hata
# alırsınız. Container içi port 5432 olarak kalır; değişen yalnızca host tarafı.
#
# Üretimde (Coolify) Postgres aynı iç ağda olduğu için normal 5432 kullanılır.
DATABASE_URL=

# --- Auth (§8.1–8.3) --------------------------------------------------------
# örn. `openssl rand -base64 32` çıktısı
AUTH_SECRET=
# örn. https://abdulkadirelaldi.com
AUTH_URL=
# tek kullanıcının e-posta adresi
ADMIN_EMAIL=
# argon2id hash — düz şifre DEĞİL (§8.2: memory >= 19MB, iterations >= 2)
ADMIN_PASSWORD_HASH=
# TOTP uygulamasında görünecek yayıncı adı, örn. Abdulkadir Elaldı Panel
TOTP_ISSUER=

# --- Depolama: Cloudflare R2 (§8.11 — private bucket, imzalı URL) -----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Mail (§4.1 iletişim formu bildirimi) -----------------------------------
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=

# --- Yedekleme (§8.21–8.23) -------------------------------------------------
# pg_dump çıktısının şifrelenmesinde kullanılır — kaybolursa yedekler açılamaz
BACKUP_ENCRYPTION_KEY=
BACKUP_R2_BUCKET=
